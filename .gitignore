# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# registro dei giri del travaso dei media: serve solo su questa macchina
scripts/*.log.jsonl

# File di lavoro degli script e scarichi temporanei: non vanno versionati.
# `tutti.mjs` legge .env.local e ha identificativi in chiaro; le bozze
# legali sono la fotografia di lavoro delle pagine gia' installate.
/bozze-legali/
/storico.mjs
/tutti.mjs
/home.html
/t.html
/r.json
